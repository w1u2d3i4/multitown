{
  "schema_version": "multitown-agentic-rl-exploration-controller-v1",
  "policy_id": "mt-agentic-rl-explore-v1",
  "policy_kind": "development-only exhaustive recovery/review exploration; not a deployable policy",
  "replan_action_space": [
    "stop",
    "delegate",
    "escalate",
    "review",
    "human/abstain"
  ],
  "replan_command_timeout_s": 120,
  "replan_interrupt_timeouts": 1,
  "replan_interrupt_failed_command_repetitions": 3,
  "replan_workspace_unchanged_requires_no_success": true,
  "replan_failed_without_success": 2,
  "replan_max_total_tokens": 90000,
  "replan_planner_turns": 3,
  "replan_executor_turns": 6,
  "agentic_review_turns": 6,
  "rollback_surfaces": [
    "workspace",
    "reports"
  ],
  "counterfactuals": [
    "plan_execute_prefix",
    "recovery",
    "review_selected"
  ]
}
